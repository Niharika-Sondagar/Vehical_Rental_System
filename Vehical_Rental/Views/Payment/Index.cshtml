@model Vehical_Rental.Models.Booking
@{
    ViewData["Title"] = $"Pay for Reservation #BK-{Model.Id} (INR)";
    var amount = Model.TotalPrice;
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Booking" asp-action="Index" class="text-decoration-none">Bookings</a></li>
        <li class="breadcrumb-item"><a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">Booking #BK-@Model.Id</a></li>
        <li class="breadcrumb-item active" aria-current="page">Payment</li>
    </ol>
</nav>

<div class="row justify-content-center py-2">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                <div class="bg-success text-white rounded-circle p-3 me-3 d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 52px; height: 52px;">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Secure Payment Checkout (INR)</h3>
                    <small class="text-muted">Vehicle owner has accepted your request. Complete payment in Indian Rupees (₹) to confirm your reservation.</small>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- Payment Methods Form -->
                <div class="col-md-7">
                    <form asp-action="Process" method="post" id="realPaymentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.Id" />
                        <input type="hidden" name="paymentMethod" id="selectedPaymentMethod" value="UPI" />

                        <h6 class="fw-bold mb-3">Select Indian Payment Method</h6>

                        <!-- Method Tabs -->
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            <button type="button" class="btn btn-outline-primary active rounded-3 px-3 py-2 flex-fill text-center method-tab-btn" onclick="selectMethod('UPI', this)">
                                <i class="bi bi-qr-code d-block fs-4 mb-1"></i> UPI / QR
                            </button>
                            <button type="button" class="btn btn-outline-secondary rounded-3 px-3 py-2 flex-fill text-center method-tab-btn" onclick="selectMethod('Card', this)">
                                <i class="bi bi-credit-card-2-front d-block fs-4 mb-1"></i> Card (RuPay/Visa)
                            </button>
                            <button type="button" class="btn btn-outline-secondary rounded-3 px-3 py-2 flex-fill text-center method-tab-btn" onclick="selectMethod('NetBanking', this)">
                                <i class="bi bi-bank d-block fs-4 mb-1"></i> Net Banking
                            </button>
                            <button type="button" class="btn btn-outline-secondary rounded-3 px-3 py-2 flex-fill text-center method-tab-btn" onclick="selectMethod('Cash', this)">
                                <i class="bi bi-cash-stack d-block fs-4 mb-1"></i> Pay at Pickup
                            </button>
                        </div>

                        <!-- UPI Section -->
                        <div id="sectionUPI" class="payment-section mb-4 p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold mb-2"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Instant UPI Payment</h6>
                            <p class="small text-muted mb-3">Pay using Google Pay, PhonePe, Paytm, BHIM, or any UPI app.</p>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Enter UPI ID / VPA</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-at"></i></span>
                                    <input type="text" class="form-control" placeholder="yourname@upi or mobile@paytm" value="customer@okhdfcbank" />
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <span class="badge bg-white text-dark border">GPay</span>
                                <span class="badge bg-white text-dark border">PhonePe</span>
                                <span class="badge bg-white text-dark border">Paytm</span>
                                <span class="badge bg-white text-dark border">BHIM</span>
                            </div>
                        </div>

                        <!-- Card Section -->
                        <div id="sectionCard" class="payment-section mb-4 p-3 bg-light rounded-3 border" style="display: none;">
                            <h6 class="fw-bold mb-2"><i class="bi bi-credit-card text-primary me-1"></i> Debit / Credit Card</h6>
                            <p class="small text-muted mb-3">Supports Indian RuPay, Visa, MasterCard cards.</p>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Cardholder Name</label>
                                <input type="text" class="form-control" placeholder="Full Name as on card" value="@(Model.User?.FullName ?? "Renter Name")" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Card Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-credit-card"></i></span>
                                    <input type="text" class="form-control" placeholder="•••• •••• •••• 4242" maxlength="19" value="4532 8901 2345 8890" />
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Expiry Date</label>
                                    <input type="text" class="form-control" placeholder="MM/YY" maxlength="5" value="12/28" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">CVV</label>
                                    <input type="password" class="form-control" placeholder="•••" maxlength="4" value="123" />
                                </div>
                            </div>
                        </div>

                        <!-- Net Banking Section -->
                        <div id="sectionNetBanking" class="payment-section mb-4 p-3 bg-light rounded-3 border" style="display: none;">
                            <h6 class="fw-bold mb-2"><i class="bi bi-bank text-primary me-1"></i> Indian Net Banking</h6>
                            <p class="small text-muted mb-3">Select your bank to authenticate and authorize transfer.</p>
                            <select class="form-select mb-2">
                                <option>State Bank of India (SBI)</option>
                                <option>HDFC Bank</option>
                                <option>ICICI Bank</option>
                                <option>Axis Bank</option>
                                <option>Kotak Mahindra Bank</option>
                                <option>Punjab National Bank</option>
                            </select>
                        </div>

                        <!-- Cash Section -->
                        <div id="sectionCash" class="payment-section mb-4 p-3 bg-light rounded-3 border" style="display: none;">
                            <h6 class="fw-bold mb-2"><i class="bi bi-cash text-success me-1"></i> Pay at Vehicle Pickup</h6>
                            <p class="small text-muted mb-0">You will pay ₹@Model.TotalPrice.ToString("N2") in cash or via UPI directly to the vehicle host upon key handover.</p>
                        </div>

                        <button type="submit" id="submitPaymentBtn" class="btn btn-success w-100 py-3 rounded-pill fw-semibold shadow-sm mb-3">
                            <i class="bi bi-shield-check me-2"></i> Authorize &amp; Pay ₹@Model.TotalPrice.ToString("N2")
                        </button>
                    </form>
                </div>

                <!-- Order Summary -->
                <div class="col-md-5">
                    <div class="card border rounded-3 p-4 bg-light h-100">
                        <h6 class="fw-bold mb-3"><i class="bi bi-receipt me-1"></i> Reservation Summary</h6>

                        <div class="mb-3 pb-3 border-bottom">
                            <div class="fw-bold fs-6">@(Model.Vehicle?.FullName ?? $"Vehicle #{Model.VehicleId}")</div>
                            <div class="small text-muted">Plate: <code>@(Model.Vehicle?.LicensePlate ?? "N/A")</code></div>
                            <div class="small text-muted">Host: <strong>@(Model.Vehicle?.Owner?.FullName ?? "Fleet Owner")</strong></div>
                            <span class="badge bg-info text-white mt-1">Approved by Host</span>
                        </div>

                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Rental Period:</span>
                            <span>@Model.StartDate.ToString("MMM dd") - @Model.EndDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Duration:</span>
                            <span>@Model.TotalDays @(Model.TotalDays == 1 ? "Day" : "Days")</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Daily Rate:</span>
                            <span>₹@(Model.Vehicle?.DailyRate.ToString("N2") ?? "0.00") / day</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Insurance &amp; Road Support:</span>
                            <span class="text-success fw-semibold">FREE / Included</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Currency:</span>
                            <span class="badge bg-secondary">INR (Indian Rupee ₹)</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fs-5 fw-bold text-dark">
                            <span>Total Due:</span>
                            <span class="text-success">₹@Model.TotalPrice.ToString("N2")</span>
                        </div>

                        <div class="mt-4 pt-3 border-top small text-muted text-center">
                            <i class="bi bi-lock-fill text-success me-1"></i> Secured with 256-Bit SSL Encryption
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectMethod(method, btn) {
            document.getElementById('selectedPaymentMethod').value = method;

            // Update tab styles
            document.querySelectorAll('.method-tab-btn').forEach(function(b) {
                b.classList.remove('btn-outline-primary', 'active');
                b.classList.add('btn-outline-secondary');
            });
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-outline-primary', 'active');

            // Toggle sections
            document.getElementById('sectionUPI').style.display = method === 'UPI' ? 'block' : 'none';
            document.getElementById('sectionCard').style.display = method === 'Card' ? 'block' : 'none';
            document.getElementById('sectionNetBanking').style.display = method === 'NetBanking' ? 'block' : 'none';
            document.getElementById('sectionCash').style.display = method === 'Cash' ? 'block' : 'none';

            var submitBtn = document.getElementById('submitPaymentBtn');
            if (method === 'Cash') {
                submitBtn.innerHTML = '<i class="bi bi-check2-circle me-2"></i> Confirm Booking (Pay ₹@Model.TotalPrice.ToString("N2") at Pickup)';
            } else {
                submitBtn.innerHTML = '<i class="bi bi-shield-check me-2"></i> Authorize &amp; Pay ₹@Model.TotalPrice.ToString("N2") via ' + method;
            }
        }
    </script>
}
