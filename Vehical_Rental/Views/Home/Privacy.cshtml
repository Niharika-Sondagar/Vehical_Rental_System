@{
    ViewData["Title"] = "Rental Policies & Privacy";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3 d-inline-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold mb-0">Rental Policy & Privacy Terms</h2>
                        <small class="text-muted">Effective Date: September 2026 | RentDrive System</small>
                    </div>
                </div>

                <div class="content">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge text-primary me-2"></i>1. Driver Eligibility & Documents</h5>
                    <p class="text-muted leading-relaxed mb-4">
                        Renters must be at least 21 years old and possess a valid, unexpired driver's license held for at least one year. An additional form of government ID (such as a passport or state ID) is required at vehicle dispatch.
                    </p>

                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-cash-coin text-primary me-2"></i>2. Security Deposit & Payments</h5>
                    <p class="text-muted leading-relaxed mb-4">
                        All rentals require upfront payment for the reserved period. A refundable security deposit is authorized upon pickup and released within 48 business hours after the vehicle is returned in satisfactory condition.
                    </p>

                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-shield-lock text-primary me-2"></i>3. Privacy & Personal Information</h5>
                    <p class="text-muted leading-relaxed mb-4">
                        We value your privacy. We collect your full name, email, phone number, and address strictly for account authentication, booking communication, and safety compliance. We never sell or share your data with unauthorized third parties.
                    </p>

                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-calendar-x text-primary me-2"></i>4. Cancellation & Extension Policy</h5>
                    <p class="text-muted leading-relaxed mb-4">
                        Cancellations made 24 hours prior to the reservation start time are eligible for a full refund. Same-day cancellations may incur a nominal processing fee equivalent to one day's rental.
                    </p>

                    <div class="p-3 bg-light rounded-3 text-secondary small mt-4">
                        If you have questions about our policies, please contact our support team at <a href="mailto:support@rentdrive.com" class="text-primary">support@rentdrive.com</a>.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
