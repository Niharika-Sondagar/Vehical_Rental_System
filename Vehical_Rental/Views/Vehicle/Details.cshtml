@model Vehical_Rental.Models.Vehicle
@{
    ViewData["Title"] = $"{Model.FullName} - Vehicle Details";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Vehicle" asp-action="Index" class="text-decoration-none">Fleet</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
    </ol>
</nav>

<div class="row g-4 mb-5">
    <!-- Vehicle Photo & Specs -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
            <div style="height: 420px; background: #0f172a; position: relative;">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=1200&q=80" : Model.ImageUrl)" 
                     alt="@Model.FullName" 
                     class="w-100 h-100 object-fit-cover" />
                
                <span class="vehicle-badge-category fs-6 px-3 py-2">
                    <i class="bi bi-tag-fill me-1"></i> @Model.Category
                </span>

                @if (Model.IsAvailable)
                {
                    <span class="vehicle-badge-status bg-success text-white fs-6 px-3 py-2">
                        <i class="bi bi-check-circle-fill me-1"></i> Ready for Rent
                    </span>
                }
                else
                {
                    <span class="vehicle-badge-status bg-danger text-white fs-6 px-3 py-2">
                        <i class="bi bi-x-circle-fill me-1"></i> Currently Unavailable
                    </span>
                }
            </div>

            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="fw-bold mb-1">@Model.Make @Model.Model</h2>
                        <span class="text-muted">Model Year: @Model.Year &bull; License Plate: <strong class="text-dark">@Model.LicensePlate</strong></span>
                    </div>
                    <div class="text-md-end mt-2 mt-md-0">
                        <div class="text-primary fw-bold display-6 mb-0">₹@Model.DailyRate.ToString("N2")</div>
                        <span class="text-muted small">Daily Base Rental Rate (INR)</span>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="star-rating me-2 fs-5">
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <span class="fw-bold fs-5 me-2">@Model.AverageRating.ToString("F1")</span>
                    <span class="text-muted">Based on @Model.Reviews.Count verified driver reviews</span>
                </div>

                <hr>

                <h5 class="fw-bold mb-3">Vehicle Specifications</h5>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <i class="bi bi-gear-wide-connected text-primary fs-3 d-block mb-1"></i>
                            <small class="text-muted d-block">Transmission</small>
                            <strong>@Model.Transmission</strong>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <i class="bi bi-fuel-pump text-primary fs-3 d-block mb-1"></i>
                            <small class="text-muted d-block">Fuel Type</small>
                            <strong>@Model.FuelType</strong>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <i class="bi bi-people-fill text-primary fs-3 d-block mb-1"></i>
                            <small class="text-muted d-block">Seating</small>
                            <strong>@Model.Seats Passengers</strong>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <i class="bi bi-calendar-event text-primary fs-3 d-block mb-1"></i>
                            <small class="text-muted d-block">Year Built</small>
                            <strong>@Model.Year</strong>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold mb-2">Vehicle Overview</h5>
                <p class="text-muted leading-relaxed mb-4">
                    @(string.IsNullOrEmpty(Model.Description) 
                        ? "This vehicle is regularly serviced, inspected according to strict manufacturer standards, and thoroughly cleaned before each handover. Equipped with power steering, climate control, Bluetooth audio connectivity, and standard safety features for smooth journeys."
                        : Model.Description)
                </p>

                <!-- Vehicle Owner / Host Card -->
                <div class="card border rounded-3 p-3 bg-light mb-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-person-check-fill fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Vehicle Host &amp; Owner</small>
                            <h6 class="fw-bold mb-0 text-dark">@(Model.Owner?.FullName ?? "Verified Vehicle Owner")</h6>
                            <small class="text-muted">
                                <i class="bi bi-shield-check text-success me-1"></i> Registered &amp; Verified Host &bull; Member since @(Model.Owner?.CreatedAt.ToString("MMM yyyy") ?? "2024")
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Vehicle Pickup Location Map Card -->
                @if (Model.Latitude != 0 || Model.Longitude != 0)
                {
                    <div class="card border rounded-3 p-3 bg-light mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Pickup Location (OpenStreetMap)
                            </h6>
                            <a asp-controller="Vehicle" asp-action="Nearby" class="btn btn-sm btn-outline-primary rounded-pill">
                                <i class="bi bi-map me-1"></i> Search Nearby Fleet
                            </a>
                        </div>
                        <div id="detailVehicleMap" style="height: 220px; width: 100%; border-radius: 10px;" class="border"></div>
                        <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                            <span id="detailAddressText"><i class="bi bi-pin-map text-primary me-1"></i> Coordinates: @Model.Latitude.ToString("F4"), @Model.Longitude.ToString("F4")</span>
                            <span class="badge bg-white text-secondary border">OpenStreetMap</span>
                        </div>
                    </div>
                }

                @{
                    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                }
                @if (User.IsInRole("VehicleOwner") && Model.OwnerId == currentUserId)
                {
                    <div class="d-flex gap-2 pt-3 border-top">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4">
                            <i class="bi bi-pencil-square me-1"></i> Edit My Vehicle
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-4">
                            <i class="bi bi-trash me-1"></i> Remove Vehicle
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Booking Calculator Box -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 85px;">
            <h4 class="fw-bold mb-3">Reserve This Car</h4>
            <div class="p-3 bg-light rounded-3 mb-4 d-flex justify-content-between align-items-center">
                <span class="text-muted">Daily Rate:</span>
                <span class="fs-4 fw-bold text-primary" id="dailyRateVal" data-rate="@Model.DailyRate">₹@Model.DailyRate.ToString("N2")</span>
            </div>

            @if (!string.IsNullOrEmpty(currentUserId) && Model.OwnerId == currentUserId)
            {
                <div class="alert alert-info rounded-4 p-4 text-center mb-3">
                    <i class="bi bi-car-front-fill fs-2 text-primary d-block mb-2"></i>
                    <h5 class="fw-bold">Your Fleet Vehicle</h5>
                    <p class="text-muted small mb-3">
                        You are the owner of this vehicle. Vehicle owners cannot rent their own vehicles, but you can freely rent any other vehicle in the fleet as a customer!
                    </p>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill w-100 py-2 mb-2">
                        <i class="bi bi-pencil-square me-1"></i> Edit This Vehicle
                    </a>
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill w-100 py-2">
                        <i class="bi bi-grid me-1"></i> Browse Other Vehicles to Rent
                    </a>
                </div>
            }
            else if (Model.IsAvailable)
            {
                <form asp-controller="Booking" asp-action="Create" method="get">
                    <input type="hidden" name="vehicleId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">Pickup Date</label>
                        <input type="date" id="calcStartDate" name="startDate" class="form-control" 
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" 
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="calculateRentalPrice()" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Return Date</label>
                        <input type="date" id="calcEndDate" name="endDate" class="form-control" 
                               value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" 
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" onchange="calculateRentalPrice()" />
                    </div>

                    <div class="border-top pt-3 mb-3">
                        <div class="d-flex justify-content-between mb-2 small text-muted">
                            <span>Rental Duration:</span>
                            <strong id="displayDuration">3 Days</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small text-muted">
                            <span>Standard Insurance:</span>
                            <span class="text-success fw-bold">Included</span>
                        </div>
                        <div class="d-flex justify-content-between fs-5 fw-bold text-dark pt-2 border-top">
                            <span>Estimated Total:</span>
                            <span class="text-primary" id="displayTotalPrice">₹@((Model.DailyRate * 3).ToString("N2"))</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-semibold shadow-sm mb-3">
                        <i class="bi bi-send-check me-2"></i> Request to Rent (₹)
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-info-circle me-1"></i> This vehicle is currently on a booking and not available for new reservations.
                </div>
                <a asp-action="Index" class="btn btn-outline-primary w-100 rounded-pill py-2">
                    Browse Other Vehicles
                </a>
            }

            <div class="mt-3 pt-3 border-top text-center text-muted small">
                <i class="bi bi-shield-check text-success me-1"></i> Free cancellation prior to owner acceptance
            </div>
        </div>
    </div>
</div>

<!-- Customer Reviews Section -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-1">Customer Reviews & Ratings</h4>
            <p class="text-muted small mb-0">Honest feedback from verified renters</p>
        </div>
        <a asp-controller="Review" asp-action="Create" asp-route-vehicleId="@Model.Id" class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-pencil me-1"></i> Write a Review
        </a>
    </div>

    @if (Model.Reviews.Any())
    {
        <div class="row g-4">
            @foreach (var review in Model.Reviews.OrderByDescending(r => r.ReviewDate))
            {
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div>
                                    <strong class="d-block small">@(review.User?.FullName ?? "Verified Customer")</strong>
                                    <span class="text-muted" style="font-size: 0.75rem;">@review.ReviewDate.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                            <div class="star-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </div>
                        </div>
                        <p class="text-muted small mb-0">"@review.Comment"</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4">
            <p class="text-muted mb-3">No reviews yet for this vehicle. Be the first to share your driving experience!</p>
            <a asp-controller="Review" asp-action="Create" asp-route-vehicleId="@Model.Id" class="btn btn-sm btn-primary rounded-pill px-3">
                Rate this Vehicle
            </a>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        function calculateRentalPrice() {
            var startInput = document.getElementById("calcStartDate").value;
            var endInput = document.getElementById("calcEndDate").value;
            var dailyRate = parseFloat(document.getElementById("dailyRateVal").getAttribute("data-rate"));

            if (startInput && endInput) {
                var start = new Date(startInput);
                var end = new Date(endInput);
                var diffTime = end.getTime() - start.getTime();
                var diffDays = Math.ceil(diffTime / (1000 * 3600 * 24));
                
                if (diffDays <= 0) {
                    diffDays = 1;
                }

                document.getElementById("displayDuration").innerText = diffDays + (diffDays === 1 ? " Day" : " Days");
                var total = (diffDays * dailyRate).toFixed(2);
                document.getElementById("displayTotalPrice").innerText = "₹" + parseFloat(total).toLocaleString('en-IN', { minimumFractionDigits: 2 });
            }
        }

        @if (Model.Latitude != 0 || Model.Longitude != 0)
        {
            <text>
            document.addEventListener("DOMContentLoaded", function () {
                var lat = @Model.Latitude;
                var lon = @Model.Longitude;
                var mapElement = document.getElementById("detailVehicleMap");
                if (mapElement && lat && lon) {
                    var map = L.map("detailVehicleMap").setView([lat, lon], 14);
                    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                        maxZoom: 19,
                        attribution: '&copy; OpenStreetMap'
                    }).addTo(map);

                    L.marker([lat, lon])
                        .addTo(map)
                        .bindPopup("<b>@Model.FullName</b><br>Pickup &amp; Return Point")
                        .openPopup();

                    // Reverse geocode address for pickup display
                    fetch('/Vehicle/ReverseGeocode?latitude=' + lat + '&longitude=' + lon)
                        .then(function(res) { return res.json(); })
                        .then(function(data) {
                            if (data && data.display_name) {
                                var shortAddr = data.display_name.split(',').slice(0, 3).join(',');
                                var el = document.getElementById("detailAddressText");
                                if (el) {
                                    el.innerHTML = '<i class="bi bi-geo-alt-fill text-danger me-1"></i> ' + shortAddr;
                                }
                            }
                        })
                        .catch(function(e) { console.log(e); });
                }
            });
            </text>
        }
    </script>
}
