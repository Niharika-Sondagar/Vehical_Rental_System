@inject Vehical_Rental.Services.Interfaces.IBookingService BookingService
@inject Vehical_Rental.Services.Interfaces.IVehicleService VehicleService
@inject Vehical_Rental.Services.Interfaces.IUserService UserService
@{
    ViewData["Title"] = "Admin Executive Dashboard";
    var recentBookings = (await BookingService.GetAllAsync()).OrderByDescending(b => b.BookingDate).Take(6).ToList();
    var vehicles = (await VehicleService.GetAllAsync()).ToList();
    var users = (await UserService.GetAllAsync()).ToList();
    var availableCount = vehicles.Count(v => v.IsAvailable);
    var rentedCount = vehicles.Count(v => !v.IsAvailable);
    var customerCount = users.Count(u => u.Role == "Customer");
    var ownerCount = users.Count(u => u.Role == "VehicleOwner");
    var suspendedCount = ViewBag.SuspendedUsersCount ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Administrative Intelligence &amp; Protection Hub</h2>
        <p class="text-muted mb-0">System analysis, revenue telemetry, fleet safety oversight, and platform protection center.</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a asp-action="Dashboard" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-graph-up-arrow me-1"></i> System Analytics
        </a>
        <a asp-action="Protection" class="btn btn-outline-danger rounded-pill px-3 shadow-sm">
            <i class="bi bi-shield-check me-1"></i> Protection Center
            @if (suspendedCount > 0)
            {
                <span class="badge bg-danger ms-1">@suspendedCount</span>
            }
        </a>
        <a asp-action="Reports" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-file-earmark-bar-graph me-1"></i> Reports
        </a>
    </div>
</div>

<!-- 4 Key Telemetry Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-card-blue h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-uppercase fw-semibold text-white-50 small mb-1">Total Fleet</h6>
                    <h2 class="display-6 fw-bold mb-0">@vehicles.Count</h2>
                    <small class="text-white-50">@availableCount Available &bull; @rentedCount Active</small>
                </div>
                <i class="bi bi-car-front-fill stat-icon"></i>
            </div>
            <div class="mt-3 pt-2 border-top border-white border-opacity-25">
                <a asp-action="Vehicles" class="text-white text-decoration-none small fw-semibold">
                    Analyze Fleet & Owners <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-card-green h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-uppercase fw-semibold text-white-50 small mb-1">Total Revenue</h6>
                    <h2 class="display-6 fw-bold mb-0">₹@((ViewBag.TotalRevenue ?? 0m).ToString("N0"))</h2>
                    <small class="text-white-50">@(ViewBag.ConfirmedBookings ?? 0) confirmed bookings</small>
                </div>
                <i class="bi bi-cash-stack stat-icon"></i>
            </div>
            <div class="mt-3 pt-2 border-top border-white border-opacity-25">
                <a asp-action="Dashboard" class="text-white text-decoration-none small fw-semibold">
                    View Financial Analytics <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-card-purple h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-uppercase fw-semibold text-white-50 small mb-1">User Ecosystem</h6>
                    <h2 class="display-6 fw-bold mb-0">@users.Count</h2>
                    <small class="text-white-50">@ownerCount Owners &bull; @customerCount Customers</small>
                </div>
                <i class="bi bi-people-fill stat-icon"></i>
            </div>
            <div class="mt-3 pt-2 border-top border-white border-opacity-25">
                <a asp-action="Users" class="text-white text-decoration-none small fw-semibold">
                    Manage User Directory <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-card-amber h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-uppercase fw-semibold text-white-50 small mb-1">System Protection</h6>
                    <h2 class="display-6 fw-bold mb-0">@(suspendedCount > 0 ? $"{suspendedCount} Held" : "Guarded")</h2>
                    <small class="text-white-50">Identity Security Active</small>
                </div>
                <i class="bi bi-shield-check stat-icon"></i>
            </div>
            <div class="mt-3 pt-2 border-top border-white border-opacity-25">
                <a asp-action="Protection" class="text-white text-decoration-none small fw-semibold">
                    Security &amp; Suspensions <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Architecture & Role Division Alert Banner -->
<div class="alert alert-info border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center gap-3">
    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
        <i class="bi bi-info-circle-fill fs-3"></i>
    </div>
    <div>
        <h6 class="fw-bold mb-1 text-primary">Role Separation Policy Active</h6>
        <p class="mb-0 text-muted small">
            Vehicle registration, updates, and removals are handled exclusively by registered <strong>Vehicle Owners</strong>. As an <strong>Administrator</strong>, your primary responsibilities are <strong>system analysis</strong> (telemetry, financials, fleet metrics) and <strong>system protection</strong> (account suspension, vehicle safety moderation, audit oversight).
        </p>
    </div>
</div>

<!-- Quick Analysis & Protection Hub -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-cpu text-primary me-2"></i>System Operations &amp; Safeguards</h5>
    <div class="row g-3">
        <div class="col-md-3">
            <a asp-action="Dashboard" class="p-3 border rounded-3 d-flex align-items-center text-decoration-none text-dark bg-light h-100 shadow-sm">
                <div class="bg-primary text-white p-2 rounded-3 me-3"><i class="bi bi-bar-chart-fill fs-5"></i></div>
                <div>
                    <div class="fw-bold">System Analytics</div>
                    <small class="text-muted">Fleet utilization & revenue</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-action="Vehicles" class="p-3 border rounded-3 d-flex align-items-center text-decoration-none text-dark bg-light h-100 shadow-sm">
                <div class="bg-success text-white p-2 rounded-3 me-3"><i class="bi bi-car-front fs-5"></i></div>
                <div>
                    <div class="fw-bold">Fleet Oversight</div>
                    <small class="text-muted">Analyze owner vehicles & rates</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-action="Protection" class="p-3 border rounded-3 d-flex align-items-center text-decoration-none text-dark bg-light h-100 shadow-sm">
                <div class="bg-danger text-white p-2 rounded-3 me-3"><i class="bi bi-shield-lock-fill fs-5"></i></div>
                <div>
                    <div class="fw-bold">Protection Center</div>
                    <small class="text-muted">User suspension & safety holds</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-action="Users" class="p-3 border rounded-3 d-flex align-items-center text-decoration-none text-dark bg-light h-100 shadow-sm">
                <div class="bg-secondary text-white p-2 rounded-3 me-3"><i class="bi bi-people-fill fs-5"></i></div>
                <div>
                    <div class="fw-bold">User Directory</div>
                    <small class="text-muted">Manage owners & customers</small>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Recent Bookings Analysis Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">Recent Platform Reservations</h5>
            <small class="text-muted">Real-time booking transactions across all vehicle owners</small>
        </div>
        <a asp-action="Bookings" class="btn btn-sm btn-outline-primary rounded-pill px-3">
            View All Reservations
        </a>
    </div>

    @if (recentBookings.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Booking ID</th>
                        <th>Vehicle &amp; Owner</th>
                        <th>Customer</th>
                        <th>Rental Period</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in recentBookings)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@b.Id</td>
                            <td>
                                <div class="fw-semibold">@(b.Vehicle?.FullName ?? $"Car #{b.VehicleId}")</div>
                                <small class="text-muted">Owner: @(b.Vehicle?.Owner?.FullName ?? "Registered Host")</small>
                            </td>
                            <td>
                                <div>@(b.User?.FullName ?? $"User #{b.UserId}")</div>
                                <small class="text-muted">@(b.User?.Email ?? "")</small>
                            </td>
                            <td>
                                <div class="small">@b.StartDate.ToString("MMM dd") - @b.EndDate.ToString("MMM dd, yyyy")</div>
                                <span class="badge bg-light text-secondary border">@b.TotalDays days</span>
                            </td>
                            <td class="fw-bold text-primary">₹@b.TotalPrice.ToString("N2")</td>
                            <td>
                                <span class="badge @(b.Status == "Confirmed" ? "bg-success" : b.Status == "Accepted" ? "bg-info text-dark" : b.Status == "Pending" ? "bg-warning text-dark" : (b.Status == "Cancelled" || b.Status == "Rejected") ? "bg-danger" : "bg-primary") rounded-pill px-3 py-1">
                                    @b.Status
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="Booking" asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary rounded-pill">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-calendar2-x fs-2 mb-2 d-block"></i>
            No bookings recorded in the system yet.
        </div>
    }
</div>
