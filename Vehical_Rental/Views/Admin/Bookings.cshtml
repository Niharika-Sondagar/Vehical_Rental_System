@inject Vehical_Rental.Services.Interfaces.IBookingService BookingService
@{
    ViewData["Title"] = "Admin - Manage Bookings";
    var bookings = await BookingService.GetAllAsync();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Reservation Operations</h2>
        <p class="text-muted mb-0">Overview of all customer bookings, approvals, and rental cycles.</p>
    </div>
    <a asp-controller="Booking" asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-circle me-1"></i> New Booking
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Booking ID</th>
                    <th>Vehicle</th>
                    <th>Customer</th>
                    <th>Dates</th>
                    <th>Days</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in bookings.OrderByDescending(x => x.BookingDate))
                {
                    <tr>
                        <td class="ps-4 fw-bold">#@b.Id</td>
                        <td>@(b.Vehicle?.FullName ?? $"Car #{b.VehicleId}")</td>
                        <td>
                            <div>@(b.User?.FullName ?? $"User #{b.UserId}")</div>
                            <small class="text-muted">@(b.User?.Email ?? "")</small>
                        </td>
                        <td>@b.StartDate.ToString("MMM dd") - @b.EndDate.ToString("MMM dd, yyyy")</td>
                        <td>@b.TotalDays d</td>
                        <td class="fw-bold text-primary">₹@b.TotalPrice.ToString("N2")</td>
                        <td>
                            <span class="badge @(b.Status == "Confirmed" ? "bg-success" : b.Status == "Accepted" ? "bg-info text-dark" : b.Status == "Pending" ? "bg-warning text-dark" : (b.Status == "Cancelled" || b.Status == "Rejected") ? "bg-danger" : "bg-primary") rounded-pill px-3 py-1">
                                @b.Status
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary rounded-pill me-1">Details</a>
                            <a asp-controller="Booking" asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-warning rounded-pill me-1">Edit</a>
                            <a asp-controller="Booking" asp-action="Delete" asp-route-id="@b.Id" class="btn btn-sm btn-outline-danger rounded-pill">Cancel</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
