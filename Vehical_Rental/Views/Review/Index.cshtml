@model IEnumerable<Vehical_Rental.Models.Review>
@{
    ViewData["Title"] = "Customer Reviews";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Customer Reviews & Ratings</h2>
        <p class="text-muted mb-0">Browse real rental feedback and reviews from our drivers.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-star-fill me-1"></i> Write a Review
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var review in Model.OrderByDescending(r => r.ReviewDate))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="star-rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-secondary opacity-50")"></i>
                            }
                        </div>
                        <span class="badge bg-light text-secondary border">@review.ReviewDate.ToString("MMM dd, yyyy")</span>
                    </div>

                    <p class="card-text text-dark flex-grow-1 my-3">
                        "@review.Comment"
                    </p>

                    <div class="pt-3 border-top mt-auto">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="fw-bold small">@(review.User?.FullName ?? $"Customer #{review.UserId}")</div>
                                <div class="small text-muted">
                                    <i class="bi bi-car-front me-1"></i> @(review.Vehicle?.FullName ?? $"Car #{review.VehicleId}")
                                </div>
                            </div>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@review.Id" class="btn btn-outline-warning btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@review.Id" class="btn btn-outline-danger btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 bg-white rounded-4 p-5 text-center shadow-sm">
        <div class="text-muted mb-3"><i class="bi bi-chat-square-quote fs-1"></i></div>
        <h4 class="fw-bold">No Reviews Yet</h4>
        <p class="text-muted">No customer reviews have been submitted yet. Share your experience!</p>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-pencil me-1"></i> Write First Review
            </a>
        </div>
    </div>
}
