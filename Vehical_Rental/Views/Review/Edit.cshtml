@model Vehical_Rental.Models.Review
@inject Vehical_Rental.Services.Interfaces.IVehicleService VehicleService
@{
    ViewData["Title"] = "Edit Review";
    var vehicles = await VehicleService.GetAllAsync();
}

<div class="row justify-content-center py-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h3 class="fw-bold mb-1">Edit Review</h3>
            <p class="text-muted small mb-4">Modify the feedback or rating score</p>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="ReviewDate" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small shadow-sm rounded-3"></div>

                <div class="mb-3">
                    <label asp-for="VehicleId" class="form-label">Vehicle</label>
                    <select asp-for="VehicleId" class="form-select" required>
                        @foreach (var v in vehicles)
                        {
                            <option value="@v.Id" selected="@(v.Id == Model.VehicleId ? "selected" : null)">
                                @v.FullName
                            </option>
                        }
                    </select>
                    <span asp-validation-for="VehicleId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Rating" class="form-label">Rating</label>
                    <select asp-for="Rating" class="form-select" required>
                        <option value="5">⭐⭐⭐⭐⭐ - 5 Stars</option>
                        <option value="4">⭐⭐⭐⭐ - 4 Stars</option>
                        <option value="3">⭐⭐⭐ - 3 Stars</option>
                        <option value="2">⭐⭐ - 2 Stars</option>
                        <option value="1">⭐ - 1 Star</option>
                    </select>
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Comment" class="form-label">Review Comment</label>
                    <textarea asp-for="Comment" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="Comment" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                    <button type="submit" class="btn btn-warning px-5 rounded-pill shadow-sm">
                        <i class="bi bi-save me-1"></i> Update Review
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
