@model IEnumerable<Vehical_Rental.Models.Review>
@{
    ViewData["Title"] = "Vehicle Reviews";
    var firstReview = Model.FirstOrDefault();
    var vehicleName = firstReview?.Vehicle?.FullName ?? "Selected Vehicle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Reviews for @vehicleName</h2>
        <p class="text-muted mb-0">Verified renter feedback and driving scores.</p>
    </div>
    <a asp-controller="Vehicle" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Back to Fleet
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var review in Model.OrderByDescending(r => r.ReviewDate))
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="star-rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-secondary opacity-50")"></i>
                            }
                        </div>
                        <small class="text-muted">@review.ReviewDate.ToString("MMMM dd, yyyy")</small>
                    </div>
                    <p class="text-dark my-2 flex-grow-1">"@review.Comment"</p>
                    <div class="pt-2 border-top small text-muted">
                        <i class="bi bi-person-circle me-1"></i> @(review.User?.FullName ?? "Verified Driver")
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 bg-white rounded-4 p-5 text-center shadow-sm">
        <div class="text-muted mb-3"><i class="bi bi-star fs-1"></i></div>
        <h4>No Reviews for this Vehicle</h4>
        <p class="text-muted">Be the first customer to leave feedback after your rental!</p>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">Leave a Review</a>
    </div>
}
