@model Vehical_Rental.Models.Review
@{
    ViewData["Title"] = $"Review for {Model.Vehicle?.FullName}";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                <div class="star-rating fs-4">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= Model.Rating ? "bi-star-fill text-warning" : "bi-star text-secondary opacity-50")"></i>
                    }
                </div>
                <span class="badge bg-light text-secondary border">@Model.ReviewDate.ToString("MMMM dd, yyyy")</span>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold mb-1">@(Model.Vehicle?.FullName ?? $"Vehicle #{Model.VehicleId}")</h5>
                <small class="text-muted">Reviewed by <strong>@(Model.User?.FullName ?? $"User #{Model.UserId}")</strong></small>
            </div>

            <div class="p-3 bg-light rounded-3 border mb-4">
                <p class="fst-italic text-dark mb-0">"@Model.Comment"</p>
            </div>

            <div class="d-flex justify-content-between pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to Reviews</a>
                @if (User.IsInRole("Admin"))
                {
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-3">Edit</a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger rounded-pill px-3">Delete</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
