@model Vehical_Rental.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <div class="p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 58px; height: 58px;">
                        <i class="bi bi-person-plus-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Create Your Account</h3>
                    <p class="text-muted small">Join RentDrive to start renting vehicles instantly</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small shadow-sm rounded-3"></div>

                    <!-- Role Selection: Customer vs Vehicle Owner -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark mb-2">Register As:</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="Role" id="roleCustomer" value="Customer" checked asp-for="Role">
                                <label class="btn btn-outline-primary w-100 py-3 px-3 text-start rounded-3 h-100 d-flex flex-column" for="roleCustomer">
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="bi bi-car-front-fill fs-4 me-2 text-primary"></i>
                                        <span class="fw-bold text-dark">Customer</span>
                                    </div>
                                    <small class="text-muted" style="font-size: 0.75rem;">Rent & drive fleet vehicles</small>
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="Role" id="roleOwner" value="VehicleOwner" asp-for="Role">
                                <label class="btn btn-outline-primary w-100 py-3 px-3 text-start rounded-3 h-100 d-flex flex-column" for="roleOwner">
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="bi bi-key-fill fs-4 me-2 text-warning"></i>
                                        <span class="fw-bold text-dark">Vehicle Owner</span>
                                    </div>
                                    <small class="text-muted" style="font-size: 0.75rem;">Add & manage my own vehicles</small>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="John Doe" required />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Password" class="form-label">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" type="password" class="form-control" placeholder="At least 6 chars" required minlength="6" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" required minlength="6" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number (India)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-semibold"><i class="bi bi-telephone me-1"></i> +91</span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="9876543210" maxlength="10" required />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Address" class="form-label">City / Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Address" class="form-control" placeholder="City, State" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="agreeTerms" required checked />
                        <label class="form-check-label small text-muted" for="agreeTerms">
                            I agree to the <a asp-controller="Home" asp-action="Privacy" class="text-primary text-decoration-none">Rental Terms & Privacy Policy</a>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 mb-3 shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Complete Registration
                    </button>
                </form>

                <div class="text-center pt-3 border-top">
                    <p class="text-muted small mb-0">
                        Already have an account? 
                        <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Sign In here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
