@{
    ViewData["Title"] = "Access Restricted";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h2 class="fw-bold mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have the required permissions or administrative privileges to access this page.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-house me-1"></i> Return Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In With Another Account
                </a>
            </div>
        </div>
    </div>
</div>
