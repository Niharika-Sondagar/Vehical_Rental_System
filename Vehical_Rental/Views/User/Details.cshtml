@model Vehical_Rental.Models.ApplicationUser
@{
    ViewData["Title"] = $"User - {Model.FullName}";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                <div class="bg-primary text-white rounded-circle p-3 me-3 d-inline-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                    <i class="bi bi-person-badge fs-2"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.FullName</h3>
                    <span class="badge @(Model.Role == "Admin" ? "bg-warning text-dark" : "bg-primary") rounded-pill px-3 py-1">
                        @Model.Role Account
                    </span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <small class="text-muted d-block">Email Address</small>
                    <strong>@Model.Email</strong>
                </div>
                <div class="col-sm-6">
                    <small class="text-muted d-block">Phone Number</small>
                    <strong>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</strong>
                </div>
                <div class="col-sm-6">
                    <small class="text-muted d-block">Address</small>
                    <strong>@(string.IsNullOrEmpty(Model.Address) ? "Not provided" : Model.Address)</strong>
                </div>
                <div class="col-sm-6">
                    <small class="text-muted d-block">Account Created</small>
                    <strong>@Model.CreatedAt.ToString("MMMM dd, yyyy")</strong>
                </div>
            </div>

            <!-- Booking history if any -->
            <div class="card border rounded-3 p-3 bg-light mb-4">
                <h6 class="fw-bold mb-2"><i class="bi bi-calendar-check me-2 text-primary"></i>Total Bookings Recorded</h6>
                <div class="display-6 fw-bold text-dark">@Model.Bookings.Count</div>
            </div>

            <div class="d-flex justify-content-between pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to Directory</a>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4">Edit User</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-4">Delete User</a>
                </div>
            </div>
        </div>
    </div>
</div>
