@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentDrive Vehicle Rental System</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3.3 CSS (CDN + Local Fallback) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS file -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vehical_Rental.styles.css" asp-append-version="true" />

    <!-- Embedded Master Stylesheet (Guarantees Instant & 100% Reliable Rendering) -->
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-light: #dbeafe;
            --secondary: #475569;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #0b1120;
            --dark-surface: #1e293b;
            --light-bg: #f8fafc;
            --card-border: #e2e8f0;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --radius-sm: 8px;
            --radius-md: 14px;
            --radius-lg: 20px;
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            --shadow-lg: 0 10px 25px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.03);
            --shadow-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        }

        body {
            background-color: var(--light-bg);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        main {
            flex: 1 0 auto;
        }

        /* Navbar */
        .navbar-custom {
            background-color: var(--dark) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 0.85rem 1rem;
            backdrop-filter: blur(12px);
        }

        .navbar-custom .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            color: #ffffff !important;
            letter-spacing: -0.5px;
        }

        .navbar-custom .nav-link {
            color: #94a3b8 !important;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 0.5rem 1rem !important;
            border-radius: var(--radius-sm);
            transition: all 0.2s ease;
        }

        .navbar-custom .nav-link:hover,
        .navbar-custom .nav-link.active {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.08);
        }

        /* Hero Banner */
        .hero-section {
            background: linear-gradient(135deg, #0b1120 0%, #1e3a8a 50%, #2563eb 100%);
            color: #ffffff;
            border-radius: var(--radius-lg);
            padding: 4rem 3rem;
            position: relative;
            overflow: hidden;
            margin-bottom: 2.5rem;
            box-shadow: var(--shadow-lg);
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 550px;
            height: 550px;
            background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        /* Cards */
        .card-custom {
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            transition: transform 0.25s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.25s ease;
            overflow: hidden;
            position: relative;
        }

        .card-custom:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-hover);
        }

        .vehicle-img-wrapper {
            position: relative;
            height: 220px;
            background: #f1f5f9;
            overflow: hidden;
        }

        .vehicle-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .card-custom:hover .vehicle-img {
            transform: scale(1.06);
        }

        .vehicle-badge-status {
            position: absolute;
            top: 14px;
            right: 14px;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.4rem 0.85rem;
            border-radius: 50px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .vehicle-badge-category {
            position: absolute;
            top: 14px;
            left: 14px;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.4rem 0.85rem;
            border-radius: 50px;
            background: rgba(11, 17, 32, 0.85);
            color: #ffffff;
            backdrop-filter: blur(6px);
        }

        /* Spec Pills */
        .spec-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: #f1f5f9;
            color: #475569;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.35rem 0.75rem;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }

        /* Star Rating */
        .star-rating {
            color: #f59e0b;
            font-size: 0.95rem;
        }

        /* Dashboard Stat Cards */
        .stat-card {
            border-radius: var(--radius-md);
            padding: 1.75rem;
            color: #ffffff;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-md);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .stat-card-blue {
            background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
        }

        .stat-card-green {
            background: linear-gradient(135deg, #065f46 0%, #10b981 100%);
        }

        .stat-card-purple {
            background: linear-gradient(135deg, #5b21b6 0%, #8b5cf6 100%);
        }

        .stat-card-amber {
            background: linear-gradient(135deg, #b45309 0%, #f59e0b 100%);
        }

        .stat-icon {
            font-size: 3rem;
            opacity: 0.22;
            position: absolute;
            right: 1.25rem;
            bottom: 1rem;
        }

        /* Tables */
        .table-custom {
            background: #ffffff;
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--card-border);
        }

        .table-custom thead, .table thead.bg-light {
            background: #f8fafc !important;
            border-bottom: 2px solid #e2e8f0;
        }

        .table-custom th, .table th {
            font-weight: 700;
            color: #475569;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 1rem;
        }

        .table td {
            padding: 1rem;
            vertical-align: middle;
            color: #334155;
            font-size: 0.95rem;
        }

        /* Buttons */
        .btn-primary {
            background-color: var(--primary) !important;
            border-color: var(--primary) !important;
            font-weight: 600;
            border-radius: 50px;
            padding: 0.55rem 1.4rem;
            transition: all 0.2s ease;
        }

        .btn-primary:hover {
            background-color: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
            transform: translateY(-1px);
        }

        .btn-outline-primary {
            color: var(--primary);
            border-color: var(--primary);
            font-weight: 600;
            border-radius: 50px;
            transition: all 0.2s ease;
        }

        .btn-outline-primary:hover {
            background-color: var(--primary);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }

        /* Filters & Search Toolbar */
        .filter-bar {
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: var(--radius-md);
            padding: 1.25rem 1.5rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
        }

        /* Badges */
        .badge {
            font-weight: 600;
            letter-spacing: 0.2px;
        }

        /* Form Controls */
        .form-control, .form-select {
            border-radius: 10px;
            border: 1px solid #cbd5e1;
            padding: 0.65rem 0.95rem;
            font-size: 0.95rem;
            color: #1e293b;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .form-label {
            font-weight: 600;
            font-size: 0.9rem;
            color: #334155;
            margin-bottom: 0.4rem;
        }

        /* Live Image Preview */
        .image-preview-container {
            height: 180px;
            border: 2px dashed #cbd5e1;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
            overflow: hidden;
            position: relative;
        }

        .image-preview-container img {
            max-height: 100%;
            max-width: 100%;
            object-fit: cover;
        }

        /* Footer */
        footer {
            background-color: var(--dark);
            color: #94a3b8;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary text-white p-2 rounded-3 me-2 d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                        <i class="bi bi-car-front-fill fs-5"></i>
                    </span>
                    <span>Rent<span class="text-primary">Drive</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Vehicle" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Explore Fleet
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Vehicle" asp-action="Nearby">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Nearby Vehicles
                            </a>
                        </li>
                        @if (!User.IsInRole("VehicleOwner"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Booking" asp-action="Index">
                                    <i class="bi bi-calendar-check me-1"></i> Bookings
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Review" asp-action="Index">
                                <i class="bi bi-star me-1"></i> Reviews
                            </a>
                        </li>
                        @if (User.IsInRole("VehicleOwner"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-info fw-semibold" href="#" id="ownerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-key-fill text-warning me-1"></i> Owner Hub
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="ownerDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Vehicle" asp-action="MyVehicles">
                                            <i class="bi bi-car-front-fill me-2 text-primary"></i> My Vehicle Fleet
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Vehicle" asp-action="Create">
                                            <i class="bi bi-plus-circle me-2 text-success"></i> Add New Vehicle
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Booking" asp-action="Requests">
                                            <i class="bi bi-inbox-fill me-2 text-warning"></i> Booking Requests
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning fw-semibold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i> Admin Portal
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2"></i> Dashboard Overview
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="bi bi-graph-up-arrow me-2 text-info"></i> System Analytics
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Protection">
                                            <i class="bi bi-shield-check me-2 text-danger"></i> Protection Center
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Vehicles">
                                            <i class="bi bi-car-front me-2"></i> Fleet Oversight
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                            <i class="bi bi-people me-2"></i> User Directory
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Bookings">
                                            <i class="bi bi-calendar-event me-2"></i> Manage Bookings
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Payment" asp-action="PaymentManagement">
                                            <i class="bi bi-credit-card-2-front me-2 text-success"></i> Payment Transactions (₹)
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Reports">
                                            <i class="bi bi-file-earmark-bar-graph me-2"></i> Financial Reports
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="bg-secondary bg-opacity-25 rounded-circle p-1 me-2 text-white d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <span>@User.Identity.Name</span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge ms-2 bg-warning text-dark">Admin</span>
                                    }
                                    else if (User.IsInRole("VehicleOwner"))
                                    {
                                        <span class="badge ms-2 bg-info text-white">Vehicle Owner</span>
                                    }
                                    else
                                    {
                                        <span class="badge ms-2 bg-primary">Customer</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-badge me-2"></i> My Profile
                                        </a>
                                    </li>
                                    @if (User.IsInRole("VehicleOwner"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Vehicle" asp-action="MyVehicles">
                                                <i class="bi bi-car-front me-2 text-primary"></i> My Vehicle Fleet
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Vehicle" asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-success"></i> Add New Vehicle
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Booking" asp-action="Requests">
                                                <i class="bi bi-inbox me-2 text-warning"></i> Booking Requests
                                            </a>
                                        </li>
                                    }
                                    else if (!User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Booking" asp-action="Index">
                                                <i class="bi bi-clock-history me-2"></i> My Bookings
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 py-1">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm w-100 text-start d-flex align-items-center">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-flex align-items-center" title="Sign Out">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3 rounded-pill" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm rounded-3" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> @TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto py-5 border-top border-secondary border-opacity-25">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white d-flex align-items-center mb-3">
                        <i class="bi bi-car-front-fill text-primary me-2"></i> RentDrive
                    </h5>
                    <p class="text-secondary small">
                        Premium vehicle rental system providing seamless self-drive and chauffeur rentals across diverse vehicle categories. Simple booking, transparent pricing, verified fleet.
                    </p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white mb-3">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a class="text-secondary text-decoration-none" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a class="text-secondary text-decoration-none" asp-controller="Vehicle" asp-action="Index">Our Fleet</a></li>
                        <li class="mb-2"><a class="text-secondary text-decoration-none" asp-controller="Booking" asp-action="Index">Reserve Car</a></li>
                        <li class="mb-2"><a class="text-secondary text-decoration-none" asp-controller="Review" asp-action="Index">Customer Reviews</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white mb-3">Vehicle Categories</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a class="text-secondary text-decoration-none" asp-controller="Vehicle" asp-action="Index">Executive Sedans</a></li>
                        <li class="mb-2"><a class="text-secondary text-decoration-none" asp-controller="Vehicle" asp-action="Index">Family SUVs & 4x4</a></li>
                        <li class="mb-2"><a class="text-secondary text-decoration-none" asp-controller="Vehicle" asp-action="Index">Luxury & Sports</a></li>
                        <li class="mb-2"><a class="text-secondary text-decoration-none" asp-controller="Vehicle" asp-action="Index">Electric & Hybrid</a></li>
                    </ul>
                </div>
              
            </div>
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25 small text-secondary">
                <div>&copy; 2026 RentDrive Vehicle Rental System. All rights reserved.</div>
                <div>
                    <a class="text-secondary text-decoration-none me-3" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a class="text-secondary text-decoration-none" href="#">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS (CDN + Local Fallback) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
